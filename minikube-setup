#!/bin/bash

# Minikube Setup Script
# Automates the complete Minikube and kubectl installation on Ubuntu

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Functions
print_status() {
    echo -e "${GREEN}[✓]${NC} $1"
}

print_error() {
    echo -e "${RED}[✗]${NC} $1"
}

print_info() {
    echo -e "${YELLOW}[i]${NC} $1"
}

check_os() {
    print_info "Checking OS compatibility..."
    if ! grep -q "Ubuntu" /etc/os-release; then
        print_error "This script is designed for Ubuntu. Please install manually."
        exit 1
    fi
    print_status "Ubuntu detected"
}

check_requirements() {
    print_info "Checking system requirements..."
    
    RAM_GB=$(free -g | awk '/^Mem:/{print $2}')
    CPU_CORES=$(nproc)
    
    print_info "System Resources: ${CPU_CORES} CPU cores, ${RAM_GB}GB RAM"
    
    if [ "$RAM_GB" -lt 2 ] || [ "$CPU_CORES" -lt 2 ]; then
        print_error "Minimum requirements: 2GB RAM and 2 CPU cores"
        exit 1
    fi
    
    print_status "System requirements met"
}

check_internet() {
    print_info "Checking internet connection..."
    if ! ping -c 1 google.com &> /dev/null; then
        print_error "No internet connection detected"
        exit 1
    fi
    print_status "Internet connection verified"
}

update_packages() {
    print_info "Updating system packages..."
    sudo apt update -y > /dev/null 2>&1
    sudo apt upgrade -y > /dev/null 2>&1
    print_status "Packages updated"
}

install_dependencies() {
    print_info "Installing dependencies..."
    sudo apt install -y curl wget apt-transport-https > /dev/null 2>&1
    print_status "Dependencies installed"
}

install_docker() {
    print_info "Installing Docker..."
    
    if command -v docker &> /dev/null; then
        print_status "Docker already installed"
        return
    fi
    
    curl -fsSL https://get.docker.com -o get-docker.sh > /dev/null 2>&1
    sudo sh get-docker.sh > /dev/null 2>&1
    rm get-docker.sh
    
    sudo usermod -aG docker $USER > /dev/null 2>&1
    newgrp docker > /dev/null 2>&1
    
    sudo systemctl enable docker > /dev/null 2>&1
    sudo systemctl start docker > /dev/null 2>&1
    
    print_status "Docker installed"
}

install_minikube() {
    print_info "Installing Minikube..."
    
    if command -v minikube &> /dev/null; then
        print_status "Minikube already installed"
        return
    fi
    
    curl -LO https://storage.googleapis.com/minikube/releases/latest/minikube-linux-amd64 > /dev/null 2>&1
    sudo install minikube-linux-amd64 /usr/local/bin/minikube > /dev/null 2>&1
    rm minikube-linux-amd64
    
    minikube config set driver docker > /dev/null 2>&1
    
    print_status "Minikube installed"
    minikube version
}

install_kubectl() {
    print_info "Installing kubectl..."
    
    if command -v kubectl &> /dev/null; then
        print_status "kubectl already installed"
        return
    fi
    
    KUBECTL_URL="https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
    curl -LO "$KUBECTL_URL" > /dev/null 2>&1
    sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl > /dev/null 2>&1
    rm kubectl
    
    print_status "kubectl installed"
    kubectl version --client --short
}

start_minikube() {
    print_info "Starting Minikube cluster..."
    
    if minikube status | grep -q "Running"; then
        print_status "Minikube already running"
        return
    fi
    
    minikube start
    print_status "Minikube cluster started"
}

verify_installation() {
    print_info "Verifying installation..."
    
    print_info "Minikube status:"
    minikube status
    
    print_info "kubectl cluster info:"
    kubectl cluster-info
    
    print_info "Kubernetes nodes:"
    kubectl get nodes
    
    print_status "Installation verified successfully"
}

print_next_steps() {
    echo -e "\n${GREEN}=== Installation Complete ===${NC}\n"
    echo -e "Next steps:\n"
    echo -e "1. Access Minikube Dashboard:"
    echo -e "   ${YELLOW}minikube dashboard${NC}\n"
    echo -e "2. Deploy a test application:"
    echo -e "   ${YELLOW}kubectl create deployment nginx --image=nginx${NC}"
    echo -e "   ${YELLOW}kubectl expose deployment nginx --port=80 --type=LoadBalancer${NC}\n"
    echo -e "3. View Docker images:"
    echo -e "   ${YELLOW}eval \$(minikube docker-env)${NC}"
    echo -e "   ${YELLOW}docker images${NC}\n"
    echo -e "4. SSH into Minikube VM:"
    echo -e "   ${YELLOW}minikube ssh${NC}\n"
    echo -e "5. Stop Minikube:"
    echo -e "   ${YELLOW}minikube stop${NC}\n"
    echo -e "Documentation: https://github.com/Lava888/Kubernetes-setup\n"
}

# Main execution
main() {
    echo -e "${GREEN}=== Minikube & kubectl Installation ===${NC}\n"
    
    check_os
    check_internet
    check_requirements
    update_packages
    install_dependencies
    install_docker
    install_minikube
    install_kubectl
    start_minikube
    verify_installation
    print_next_steps
}

# Run main function
main
